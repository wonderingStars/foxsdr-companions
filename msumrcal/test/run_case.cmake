# Runs one msumrcal test case. Variables: HELPER GEN WORK SRC MODE NAME [EXTRA (comma list)] [INPUT] [NOPROTO]
file(MAKE_DIRECTORY ${WORK}/${NAME}.d)
set(D ${WORK}/${NAME}.d)
set(ARGS "")
if(NOT NOPROTO)
  list(APPEND ARGS --foxsdr-helper 1)
endif()
set(HAVE_FORMAT FALSE)
if(DEFINED EXTRA)
  string(REPLACE "," ";" EXTRA_LIST "${EXTRA}")
  if("--format" IN_LIST EXTRA_LIST)
    set(HAVE_FORMAT TRUE)
  endif()
endif()
if(NOT HAVE_FORMAT)
  list(APPEND ARGS --format msumr-lines)
endif()
if(DEFINED EXTRA)
  list(APPEND ARGS ${EXTRA_LIST})
endif()

function(fail msg)
  message(FATAL_ERROR "${NAME}: ${msg}")
endfunction()

# input file: a checked-in one, or the generated synthetic pass
if(DEFINED INPUT)
  set(IN ${SRC}/input/${INPUT})
else()
  set(IN ${D}/pass.txt)
  execute_process(COMMAND ${GEN} gen ${IN} ${D}/truth.txt RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    fail("generator failed")
  endif()
endif()

function(run_helper in out_var err_var rc_var)
  execute_process(COMMAND ${HELPER} ${ARGS} INPUT_FILE ${in}
    OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE r)
  set(${out_var} "${o}" PARENT_SCOPE)
  set(${err_var} "${e}" PARENT_SCOPE)
  set(${rc_var} "${r}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "info")
  execute_process(COMMAND ${HELPER} --foxsdr-helper-info OUTPUT_VARIABLE o RESULT_VARIABLE r)
  if(NOT r EQUAL 0 OR NOT o MATCHES "\"name\":\"msumrcal\"" OR NOT o MATCHES "\"format\":\"msumr-lines\"")
    fail("manifest wrong: rc=${r} out=${o}")
  endif()
  # the manifest file shipped in the folder must be the same text
  file(READ ${SRC}/../msumrcal.helper.json shipped)
  string(STRIP "${shipped}" shipped)
  string(STRIP "${o}" o)
  if(NOT shipped STREQUAL o)
    fail("msumrcal.helper.json differs from --foxsdr-helper-info")
  endif()

elseif(MODE STREQUAL "compare")
  run_helper(${IN} out err rc)
  if(NOT rc EQUAL 0)
    fail("exit ${rc}: ${err}")
  endif()
  set(EXP ${SRC}/expected/${NAME}.jsonl)
  if(DEFINED ENV{MM_UPDATE} OR NOT EXISTS ${EXP})
    file(WRITE ${EXP} "${out}")
    message(STATUS "${NAME}: wrote ${EXP}")
  endif()
  file(READ ${EXP} want)
  string(REPLACE "\r\n" "\n" want "${want}")
  string(REPLACE "\r\n" "\n" out "${out}")
  if(NOT out STREQUAL want)
    file(WRITE ${D}/actual.jsonl "${out}")
    fail("output differs from ${EXP} (actual in ${D}/actual.jsonl)")
  endif()

elseif(MODE STREQUAL "truth")
  run_helper(${IN} out err rc)
  if(NOT rc EQUAL 0)
    fail("exit ${rc}: ${err}")
  endif()
  file(WRITE ${D}/out.jsonl "${out}")
  execute_process(COMMAND ${GEN} check ${D}/out.jsonl ${D}/truth.txt RESULT_VARIABLE r ERROR_VARIABLE e OUTPUT_VARIABLE o)
  if(NOT r EQUAL 0)
    fail("truth check failed: ${e}")
  endif()
  message(STATUS "${o}")

elseif(MODE STREQUAL "twice")
  run_helper(${IN} a e1 r1)
  run_helper(${IN} b e2 r2)
  if(NOT r1 EQUAL 0 OR NOT r2 EQUAL 0 OR NOT a STREQUAL b OR a STREQUAL "")
    fail("two runs differ or failed")
  endif()

elseif(MODE STREQUAL "empty")
  file(WRITE ${D}/empty.txt "")
  run_helper(${D}/empty.txt out err rc)
  string(REGEX MATCHALL "\n" nl "${out}")
  list(LENGTH nl n)
  if(NOT rc EQUAL 0 OR NOT n EQUAL 1 OR NOT out MATCHES "^{\"helper\":\"msumrcal\"")
    fail("empty input: want exactly the hello line and exit 0; rc=${rc} out=${out}")
  endif()

elseif(MODE STREQUAL "garbage")
  string(REPEAT "A" 300000 big)
  file(WRITE ${D}/garbage.txt "T 0 1 2\nP x y z\n${big}\nT 1 - - - - 1 2 3 4 5 6\nZ 1 2 3\n")
  string(RANDOM LENGTH 20000 ALPHABET "0123456789 -+.eE#TP\t\r!@" RANDOM_SEED 7 rnd)
  file(APPEND ${D}/garbage.txt "${rnd}\n${rnd}")
  run_helper(${D}/garbage.txt out err rc)
  string(REGEX MATCHALL "\n" nl "${out}")
  list(LENGTH nl n)
  if(NOT rc EQUAL 0)
    fail("garbage input crashed or failed: rc=${rc}")
  endif()
  if(n GREATER 40)
    fail("garbage input flooded stdout: ${n} lines")
  endif()
  if(NOT out MATCHES "\"type\":\"stats\"" OR out MATCHES "\"bad_lines\":0[,}]")
    fail("garbage input: bad lines were not counted: ${out}")
  endif()

elseif(MODE STREQUAL "fail")
  run_helper(${IN} out err rc)
  if(rc EQUAL 0 OR NOT out STREQUAL "" OR err STREQUAL "")
    fail("expected non-zero exit, empty stdout and a message on stderr; rc=${rc} out=${out} err=${err}")
  endif()

else()
  fail("unknown mode ${MODE}")
endif()
