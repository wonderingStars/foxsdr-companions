# Runs one hamdrm test case. Variables: HELPER TXGEN SIGTOOL WORK SRC MODE NAME [TX (comma list of txgen options)] [PAYLOAD file in test/input]
# [ARGS (comma list of extra helper options)] [OUTDIR 1] [CUT seconds to keep] [EXPECT_NAME text] [WANT_FILES n]
file(MAKE_DIRECTORY ${WORK}/${NAME}.d)
set(D ${WORK}/${NAME}.d)

function(fail msg)
  message(FATAL_ERROR "${NAME}: ${msg}")
endfunction()

set(HARGS --foxsdr-helper 1 --format s16 --rate 12000)
if(DEFINED ARGS)
  string(REPLACE "," ";" ARGS_LIST "${ARGS}")
  set(HARGS ${ARGS_LIST})
endif()

# ---- build the input signal with the generator (when TX is given)
function(make_signal out)
  if(NOT DEFINED PAYLOAD)
    set(pl ${SRC}/input/hello.txt)
  else()
    set(pl ${SRC}/input/${PAYLOAD})
  endif()
  if(DEFINED RSTYPE)
    # Reed-Solomon coded file (.rs1 .. .rs4) as QSSTV sends it: the extension of the original travels inside
    execute_process(COMMAND ${SIGTOOL} rsenc ${pl} ${D}/payload.rs ${RSTYPE} bin RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      fail("rsenc failed")
    endif()
    set(pl ${D}/payload.rs)
  endif()
  set(txargs "")
  if(DEFINED TX)
    string(REPLACE "," ";" txargs "${TX}")
  endif()
  if(DEFINED SENDNAME)
    set(nm ${SENDNAME})
  else()
    set(nm test.txt)
  endif()
  execute_process(COMMAND ${TXGEN} --in ${pl} --name ${nm} --out ${out} ${txargs}
    RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    fail("generator failed: ${e}${o}")
  endif()
endfunction()

function(run_helper in out_var err_var rc_var)
  set(extra "")
  if(OUTDIR)
    file(REMOVE_RECURSE ${D}/out)
    file(MAKE_DIRECTORY ${D}/out)
    set(extra --out-dir ${D}/out)
  endif()
  execute_process(COMMAND ${HELPER} ${HARGS} ${extra} INPUT_FILE ${in}
    OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE r)
  set(${out_var} "${o}" PARENT_SCOPE)
  set(${err_var} "${e}" PARENT_SCOPE)
  set(${rc_var} "${r}" PARENT_SCOPE)
endfunction()

function(count_lines text var)
  string(REGEX MATCHALL "\n" nl "${text}")
  list(LENGTH nl n)
  set(${var} ${n} PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "info")
  execute_process(COMMAND ${HELPER} --foxsdr-helper-info OUTPUT_VARIABLE o RESULT_VARIABLE r)
  if(NOT r EQUAL 0 OR NOT o MATCHES "\"name\":\"hamdrm\"" OR NOT o MATCHES "\"rate\":12000")
    fail("manifest wrong: rc=${r} out=${o}")
  endif()
  file(READ ${SRC}/../hamdrm.helper.json shipped)
  string(STRIP "${shipped}" shipped)
  string(STRIP "${o}" o)
  if(NOT shipped STREQUAL o)
    fail("hamdrm.helper.json differs from --foxsdr-helper-info")
  endif()

elseif(MODE STREQUAL "empty")
  file(WRITE ${D}/empty.raw "")
  run_helper(${D}/empty.raw out err rc)
  count_lines("${out}" n)
  if(NOT rc EQUAL 0 OR NOT n EQUAL 1 OR NOT out MATCHES "^{\"helper\":\"hamdrm\"")
    fail("empty input: want exactly the hello line and exit 0; rc=${rc} out=${out}")
  endif()

elseif(MODE STREQUAL "fail")
  file(WRITE ${D}/empty.raw "")
  execute_process(COMMAND ${HELPER} ${HARGS} INPUT_FILE ${D}/empty.raw OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(rc EQUAL 0 OR NOT out STREQUAL "" OR err STREQUAL "")
    fail("expected non-zero exit, empty stdout and a message on stderr; rc=${rc} out=${out} err=${err}")
  endif()

elseif(MODE STREQUAL "garbage")
  # deterministic pseudo-random bytes: 30 s of 16-bit noise at full scale and a run of text, none of it a signal
  string(RANDOM LENGTH 6000 ALPHABET "0123456789abcdefABCDEF" RANDOM_SEED 11 hex)
  file(WRITE ${D}/garbage.txt "${hex}\n")
  set(big "")
  foreach(i RANGE 1 400)
    string(APPEND big "${hex}${hex}")
  endforeach()
  file(WRITE ${D}/garbage2.txt "${big}")
  foreach(g garbage.txt garbage2.txt)
    run_helper(${D}/${g} out err rc)
    string(REGEX REPLACE "[^\n]*\"type\":\"stats\"[^\n]*\n" "" nostats "${out}")
    count_lines("${nostats}" n)
    if(NOT rc EQUAL 0)
      fail("garbage input ${g}: rc=${rc}")
    endif()
    if(n GREATER 20)
      fail("garbage input ${g} flooded stdout: ${n} lines")
    endif()
    if(out MATCHES "\"type\":\"file\"")
      fail("garbage input produced a file event")
    endif()
  endforeach()

elseif(MODE STREQUAL "noise")
  execute_process(COMMAND ${SIGTOOL} noise ${D}/noise.s16 40 3 RESULT_VARIABLE rc ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    fail("noise generator failed: ${e}")
  endif()
  run_helper(${D}/noise.s16 out err rc)
  if(NOT rc EQUAL 0 OR out MATCHES "\"type\":\"file\"" OR out MATCHES "\"type\":\"segment\"")
    fail("noise produced a decode: ${out}")
  endif()

elseif(MODE STREQUAL "compare" OR MODE STREQUAL "decode" OR MODE STREQUAL "twice" OR MODE STREQUAL "partial" OR MODE STREQUAL "rs" OR MODE STREQUAL "hybrid")
  make_signal(${D}/sig.s16)
  set(IN ${D}/sig.s16)
  if(DEFINED CUT)
    execute_process(COMMAND ${SIGTOOL} cut ${D}/sig.s16 ${D}/cut.s16 ${CUT} RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      fail("cut failed")
    endif()
    set(IN ${D}/cut.s16)
  endif()
  if(DEFINED GAP)
    string(REPLACE "," ";" gl "${GAP}")
    execute_process(COMMAND ${SIGTOOL} gap ${IN} ${D}/gap.s16 ${gl} RESULT_VARIABLE rc)
    set(IN ${D}/gap.s16)
  endif()
  if(DEFINED NOISE_RMS)
    execute_process(COMMAND ${SIGTOOL} mix ${IN} ${D}/mix.s16 5 ${NOISE_RMS} RESULT_VARIABLE rc)
    set(IN ${D}/mix.s16)
  endif()
  run_helper(${IN} out err rc)
  if(NOT rc EQUAL 0)
    fail("exit ${rc}: ${err}")
  endif()
  if(MODE STREQUAL "twice")
    run_helper(${IN} out2 err2 rc2)
    if(NOT out STREQUAL out2 OR NOT rc2 EQUAL 0)
      fail("two runs of the same signal differ")
    endif()
  endif()
  # the received file must be the payload
  if(MODE STREQUAL "decode" OR MODE STREQUAL "compare" OR MODE STREQUAL "twice" OR MODE STREQUAL "rs")
    if(NOT DEFINED PAYLOAD)
      set(pl ${SRC}/input/hello.txt)
    else()
      set(pl ${SRC}/input/${PAYLOAD})
    endif()
    file(SHA256 ${pl} want_sha)
    string(FIND "${out}" "\"sha256\":\"${want_sha}\"" pos)
    if(pos EQUAL -1)
      fail("no file event with the payload's sha256 ${want_sha}; output:\n${out}")
    endif()
    if(OUTDIR)
      if(DEFINED EXPECT_NAME)
        set(en ${EXPECT_NAME})
      else()
        set(en test.txt)
      endif()
      if(NOT EXISTS ${D}/out/${en})
        file(GLOB written ${D}/out/*)
        fail("expected ${en} in the output folder; found: ${written}")
      endif()
      file(SHA256 ${D}/out/${en} got_sha)
      if(NOT got_sha STREQUAL want_sha)
        fail("written file differs from the payload")
      endif()
    endif()
  endif()
  if(MODE STREQUAL "rs" AND NOT out MATCHES "\"fec\":\"rs2\"")
    fail("the file was not reported as Reed-Solomon decoded:
${out}")
  endif()
  if(MODE STREQUAL "hybrid")
    if(NOT out MATCHES "\"note\":\"hybrid\"")
      fail("a hybrid name should be reported with note hybrid:
${out}")
    endif()
    file(GLOB written ${D}/out/*)
    if(written)
      fail("a hybrid transfer wrote something: ${written}")
    endif()
  endif()
  if(MODE STREQUAL "partial")
    if(out MATCHES "\"type\":\"file\"" OR NOT out MATCHES "\"type\":\"segment\"")
      fail("a cut signal should show segments but no file:\n${out}")
    endif()
  endif()
  if(MODE STREQUAL "compare")
    set(EXP ${SRC}/expected/${NAME}.jsonl)
    string(REPLACE "\r\n" "\n" out "${out}")
    if(DEFINED ENV{MM_UPDATE} OR NOT EXISTS ${EXP})
      file(WRITE ${EXP} "${out}")
      message(STATUS "${NAME}: wrote ${EXP}")
    endif()
    file(READ ${EXP} want)
    string(REPLACE "\r\n" "\n" want "${want}")
    if(NOT out STREQUAL want)
      file(WRITE ${D}/actual.jsonl "${out}")
      fail("output differs from ${EXP} (actual in ${D}/actual.jsonl)")
    endif()
  endif()

else()
  fail("unknown mode ${MODE}")
endif()
