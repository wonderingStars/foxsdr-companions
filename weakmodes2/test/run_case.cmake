# Runs one test case of the weakmodes2 helper. Called as  cmake -DMODE=... -DNAME=... -DHELPER=... -P run_case.cmake
# Variables: MODE (compare | twice | fail | empty | garbage | info | grep), NAME, HELPER, ARGS (helper arguments, '|' separated),
#   GEN (wm2gen executable) and GENARGS ('|' separated; the output file is appended as --out), INPUT (an existing file), EXPECTED (file
#   with the pinned JSON Lines), WORK (scratch directory), MANIFEST (for info), PATTERN (for grep).
# MODE compare: output lines must equal EXPECTED exactly (MM_UPDATE=1 in the environment rewrites EXPECTED).
# MODE twice:   two runs give byte-identical output, and the output has at least one decode line.
# MODE fail:    exit code non-zero, nothing on stdout, a message on stderr.
# MODE empty:   zero bytes of input: exit 0 and exactly the hello line and the stats line.
# MODE garbage: INPUT is random bytes: exit 0, the process ends, fewer than 50 output lines.
string(REPLACE "|" ";" ARGS "${ARGS}")
string(REPLACE "|" ";" GENARGS "${GENARGS}")
file(MAKE_DIRECTORY ${WORK})
set(PID_TAG ${NAME})
set(IN ${INPUT})
if(GEN AND GENARGS)
  set(IN ${WORK}/${PID_TAG}.raw)
  execute_process(COMMAND ${GEN} ${GENARGS} --out ${IN} RESULT_VARIABLE grc ERROR_VARIABLE gerr)
  if(NOT grc EQUAL 0)
    message(FATAL_ERROR "${NAME}: generator failed (${grc}): ${gerr}")
  endif()
endif()

if(MODE STREQUAL "empty" AND NOT IN)
  # an explicit empty file: never inherit the caller's standard input
  set(IN ${WORK}/${PID_TAG}.empty)
  file(WRITE ${IN} "")
endif()

function(run_helper OUTVAR RCVAR ERRVAR)
  if(IN)
    execute_process(COMMAND ${HELPER} ${ARGS} INPUT_FILE ${IN} OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE r)
  else()
    execute_process(COMMAND ${HELPER} ${ARGS} OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE r)
  endif()
  string(REPLACE "\r\n" "\n" o "${o}")
  set(${OUTVAR} "${o}" PARENT_SCOPE)
  set(${RCVAR} "${r}" PARENT_SCOPE)
  set(${ERRVAR} "${e}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "info")
  execute_process(COMMAND ${HELPER} --foxsdr-helper-info OUTPUT_VARIABLE o RESULT_VARIABLE r)
  file(READ ${MANIFEST} m)
  string(REPLACE "\r\n" "\n" o "${o}")
  string(REPLACE "\r\n" "\n" m "${m}")
  if(NOT r EQUAL 0 OR NOT o STREQUAL m)
    message(FATAL_ERROR "${NAME}: --foxsdr-helper-info (exit ${r}) does not print the manifest")
  endif()
  return()
endif()

run_helper(OUT RC ERR)

if(MODE STREQUAL "fail")
  if(RC EQUAL 0)
    message(FATAL_ERROR "${NAME}: expected a non-zero exit code, got 0")
  endif()
  if(NOT OUT STREQUAL "")
    message(FATAL_ERROR "${NAME}: expected nothing on stdout, got: ${OUT}")
  endif()
  if(ERR STREQUAL "")
    message(FATAL_ERROR "${NAME}: expected a message on stderr")
  endif()
  if(PATTERN AND NOT ERR MATCHES "${PATTERN}")
    message(FATAL_ERROR "${NAME}: stderr does not match '${PATTERN}': ${ERR}")
  endif()
  return()
endif()

if(NOT RC EQUAL 0)
  message(FATAL_ERROR "${NAME}: exit code ${RC}\n${ERR}\n${OUT}")
endif()
string(REGEX REPLACE "\n$" "" OUTT "${OUT}")
string(REPLACE "\n" ";" LINES "${OUTT}")
list(LENGTH LINES NL)

if(MODE STREQUAL "empty")
  if(NOT NL EQUAL 2)
    message(FATAL_ERROR "${NAME}: expected the hello and stats lines only, got ${NL} lines:\n${OUT}")
  endif()
  list(GET LINES 0 L0)
  list(GET LINES 1 L1)
  if(NOT L0 MATCHES "^\{\"helper\":\"weakmodes2\"" OR NOT L1 MATCHES "\"type\":\"stats\",\"samples\":0,")
    message(FATAL_ERROR "${NAME}: unexpected lines:\n${OUT}")
  endif()
  return()
endif()

if(MODE STREQUAL "garbage")
  if(NL GREATER 50)
    message(FATAL_ERROR "${NAME}: ${NL} output lines for garbage input")
  endif()
  return()
endif()

if(MODE STREQUAL "twice")
  run_helper(OUT2 RC2 ERR2)
  if(NOT OUT STREQUAL OUT2)
    message(FATAL_ERROR "${NAME}: two runs on the same input differ")
  endif()
  if(NOT OUT MATCHES "\"type\":\"decode\"")
    message(FATAL_ERROR "${NAME}: no decode line")
  endif()
  return()
endif()

if(MODE STREQUAL "grep")
  if(NOT OUT MATCHES "${PATTERN}")
    message(FATAL_ERROR "${NAME}: output does not match '${PATTERN}':\n${OUT}")
  endif()
  return()
endif()

# compare
if("$ENV{MM_UPDATE}" STREQUAL "1")
  file(WRITE ${EXPECTED} "${OUT}")
  message(STATUS "${NAME}: expectation rewritten")
  return()
endif()
if(NOT EXISTS ${EXPECTED})
  message(FATAL_ERROR "${NAME}: no expectation file ${EXPECTED} (run with MM_UPDATE=1 to create it)")
endif()
file(READ ${EXPECTED} EXP)
string(REPLACE "\r\n" "\n" EXP "${EXP}")
if(NOT OUT STREQUAL EXP)
  message(FATAL_ERROR "${NAME}: output differs from ${EXPECTED}\n--- got ---\n${OUT}\n--- expected ---\n${EXP}")
endif()
