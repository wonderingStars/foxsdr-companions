+        std::string PacketVars::quote(const std::string& in) {
+            std::string o = "\"";
+            for(size_t i = 0; i < in.size(); i++) {
+                unsigned char c = (unsigned char)in[i];
+                if(c == '"') { o += "\\\""; }
+                else if(c == '\\') { o += "\\\\"; }
+                else if(c < 0x20 || c >= 0x7F) { char b[8]; std::snprintf(b, sizeof(b), "\\u%04x", c); o += b; }
