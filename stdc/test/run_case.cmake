# Test driver for the stdc helper: one script, several modes (-DMODE=...), run by CTest as
#   cmake -DMODE=... -DHELPER=... -DGEN=... -DWORK=... [-DARGS=a|b|c] [-DSCENARIO=.. -DSIGMODE=.. -DGENOPTS=a|b]
#         [-DEXPECTED=...] -P run_case.cmake
# ARGS and GENOPTS are lists separated by '|' (CTest cannot pass lists with ';' reliably).
# Set the environment variable STDC_UPDATE=1 to rewrite EXPECTED from the current output instead of comparing
# (review the git diff before committing it).
#
# MODE
#   compare    signal made by stdc-gen (SCENARIO SIGMODE GENOPTS); stdout must equal EXPECTED byte for byte, exit 0
#   twice      same, run two times: the two outputs must be identical (determinism) and equal EXPECTED
#   pipe       as compare, but the signal is fed through a pipe in writes of CHUNK bytes (default 777)
#   skiphello  as compare but the hello line (line 1, which names the sample format) is not compared
#   forbid     as compare, and stdout must contain none of FORBID (|-separated) and every MUST (|-separated)
#   nopackets  no "type":"packet" line may appear, exit 0; stdout must equal EXPECTED
#   counts     regex STATS_REGEX must match the last stdout line (the signal is INPUT_FILE if given)
#   fail       run with ARGS: exit code must be 2, stdout empty, stderr must match STDERR_REGEX
#   empty      empty stdin: stdout must be exactly the hello line (EXPECTED), exit code 0
#   garbage    GARBAGE_BYTES of pseudo-random input: exit code 0, at most MAX_LINES lines out
#   oddbyte    signal plus one stray byte: stdout equals EXPECTED, stderr mentions the cut-off sample
#   info       --foxsdr-helper-info output must equal the manifest file EXPECTED
#   nowindow   hello line must contain every |-separated MUST_CONTAIN string

if(NOT DEFINED NAME)
  set(NAME case)
endif()
if(NOT DEFINED CHUNK)
  set(CHUNK 777)
endif()
file(MAKE_DIRECTORY "${WORK}")
string(REPLACE "|" ";" ARGLIST "${ARGS}")
string(REPLACE "|" ";" GENLIST "${GENOPTS}")
set(OUT "${WORK}/${NAME}.out")
set(ERR "${WORK}/${NAME}.err")
set(IN "${WORK}/${NAME}.raw")

function(finish_compare out expected)
  if(DEFINED ENV{STDC_UPDATE})
    configure_file("${out}" "${expected}" COPYONLY)
    message(STATUS "updated ${expected}")
    return()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${out}" "${expected}" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    file(READ "${out}" got)
    file(READ "${expected}" want)
    string(LENGTH "${got}" gl)
    string(LENGTH "${want}" wl)
    string(SUBSTRING "${got}" 0 3000 got)
    string(SUBSTRING "${want}" 0 3000 want)
    message(FATAL_ERROR "output differs from ${expected} (${gl} vs ${wl} bytes)\n--- got (first 3000) ---\n${got}\n--- expected (first 3000) ---\n${want}")
  endif()
endfunction()

function(run_helper in_file out_file err_file)
  execute_process(COMMAND "${HELPER}" ${ARGLIST} ${ARGN}
                  INPUT_FILE "${in_file}" OUTPUT_FILE "${out_file}" ERROR_FILE "${err_file}"
                  RESULT_VARIABLE rc)
  set(RC ${rc} PARENT_SCOPE)
endfunction()

function(make_signal)
  if(DEFINED INPUT_FILE AND NOT INPUT_FILE STREQUAL "")
    set(IN "${INPUT_FILE}" PARENT_SCOPE)
    return()
  endif()
  file(REMOVE "${IN}")
  execute_process(COMMAND "${GEN}" ${SCENARIO} ${SIGMODE} "${IN}" ${GENLIST}
                  RESULT_VARIABLE grc ERROR_VARIABLE generr)
  if(NOT grc EQUAL 0 OR NOT EXISTS "${IN}")
    message(FATAL_ERROR "stdc-gen failed (${grc}): ${generr}")
  endif()
endfunction()

function(read_lines file outvar)
  file(READ "${file}" content)
  string(REPLACE "\r\n" "\n" content "${content}")
  set(${outvar} "${content}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "compare")
  make_signal()
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    file(READ "${ERR}" e)
    message(FATAL_ERROR "helper exited with ${RC}\n${e}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "twice")
  make_signal()
  run_helper("${IN}" "${OUT}" "${ERR}")
  run_helper("${IN}" "${OUT}.2" "${ERR}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}" "${OUT}.2" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    message(FATAL_ERROR "two runs on the same input gave different output (${OUT} vs ${OUT}.2)")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "pipe")
  make_signal()
  execute_process(COMMAND "${GEN}" feed "${IN}" ${CHUNK}
                  COMMAND "${HELPER}" ${ARGLIST}
                  OUTPUT_FILE "${OUT}" ERROR_FILE "${ERR}" RESULTS_VARIABLE rcs)
  list(GET rcs 1 rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "helper exited with ${rc} (feed: ${rcs})")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "skiphello")
  make_signal()
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  file(STRINGS "${OUT}" lines)
  list(REMOVE_AT lines 0)
  list(JOIN lines "\n" body)
  file(WRITE "${OUT}.body" "${body}\n")
  file(STRINGS "${EXPECTED}" elines)
  list(REMOVE_AT elines 0)
  list(JOIN elines "\n" ebody)
  file(WRITE "${OUT}.ebody" "${ebody}\n")
  finish_compare("${OUT}.body" "${OUT}.ebody")

elseif(MODE STREQUAL "forbid")
  make_signal()
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  file(READ "${OUT}" o)
  string(REPLACE "|" ";" forbid "${FORBID}")
  foreach(f IN LISTS forbid)
    string(FIND "${o}" "${f}" pos)
    if(NOT pos EQUAL -1)
      message(FATAL_ERROR "output contains forbidden text '${f}'")
    endif()
  endforeach()
  string(REPLACE "|" ";" must "${MUST}")
  foreach(m IN LISTS must)
    string(FIND "${o}" "${m}" pos)
    if(pos EQUAL -1)
      message(FATAL_ERROR "output lacks required text '${m}'")
    endif()
  endforeach()
  if(NOT EXPECTED STREQUAL "" AND EXISTS "${EXPECTED}" OR DEFINED ENV{STDC_UPDATE})
    finish_compare("${OUT}" "${EXPECTED}")
  endif()

elseif(MODE STREQUAL "nopackets")
  make_signal()
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  file(READ "${OUT}" o)
  string(FIND "${o}" "\"type\":\"packet\"" pos)
  if(NOT pos EQUAL -1)
    message(FATAL_ERROR "a packet was printed from a signal that must not yield one:\n${o}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "counts")
  make_signal()
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  file(STRINGS "${OUT}" lines)
  list(GET lines -1 last)
  if(NOT last MATCHES "${STATS_REGEX}")
    message(FATAL_ERROR "last line does not match ${STATS_REGEX}:\n${last}")
  endif()
  message(STATUS "counts: ${last}")

elseif(MODE STREQUAL "fail")
  file(WRITE "${WORK}/empty.raw" "")
  run_helper("${WORK}/empty.raw" "${OUT}" "${ERR}")
  file(READ "${OUT}" o)
  file(READ "${ERR}" e)
  if(NOT RC EQUAL 2)
    message(FATAL_ERROR "expected exit code 2, got ${RC}\nstderr: ${e}")
  endif()
  if(NOT o STREQUAL "")
    message(FATAL_ERROR "expected nothing on stdout, got: ${o}")
  endif()
  if(NOT e MATCHES "${STDERR_REGEX}")
    message(FATAL_ERROR "stderr does not match '${STDERR_REGEX}':\n${e}")
  endif()

elseif(MODE STREQUAL "empty")
  file(WRITE "${WORK}/empty.raw" "")
  run_helper("${WORK}/empty.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on empty input")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "garbage")
  file(REMOVE "${IN}")
  execute_process(COMMAND "${GEN}" garbage 12345 "${IN}" ${GARBAGE_BYTES} RESULT_VARIABLE grc)
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on garbage input")
  endif()
  file(STRINGS "${OUT}" lines)
  list(LENGTH lines nlines)
  if(nlines GREATER MAX_LINES)
    message(FATAL_ERROR "garbage input produced ${nlines} lines (limit ${MAX_LINES})")
  endif()
  message(STATUS "garbage input: ${nlines} lines out")

elseif(MODE STREQUAL "oddbyte")
  make_signal()
  file(READ "${IN}" hexdata HEX)
  string(APPEND hexdata "5a")
  # write the signal plus one stray byte without going through text
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${IN}" "${IN}.odd")
  file(APPEND "${IN}.odd" "Z")
  run_helper("${IN}.odd" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  file(READ "${ERR}" e)
  if(NOT e MATCHES "middle of a sample")
    message(FATAL_ERROR "no warning about the cut-off sample on stderr:\n${e}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "info")
  execute_process(COMMAND "${HELPER}" --foxsdr-helper-info OUTPUT_FILE "${OUT}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--foxsdr-helper-info exited with ${rc}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
