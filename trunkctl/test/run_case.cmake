# Test driver for the trunkctl helper: one script, several modes (-DMODE=...), run by CTest as
#   cmake -DMODE=... -DHELPER=... [-DARGS=a|b|c] [-DGEN=...] [-DEXPECTED=...] -P run_case.cmake
# ARGS are helper arguments separated by '|' (CTest cannot pass lists with ';' reliably).
# GEN is scenario|rate|format|options... for trunkgen (the output file is added by this script).
# Set the environment variable TC_UPDATE=1 to rewrite EXPECTED from the current output instead of comparing
# (review the diff before committing it).
#
# MODE
#   gen       the helper reads the generated signal; stdout must equal EXPECTED byte for byte, exit code 0, and a
#             second run must give the same bytes (determinism)
#   body      as gen, but the hello line is not compared (the same events through another door: f32 ...)
#   types     the lines of the given TYPES (|-separated) must equal those of EXPECTED, ignoring time stamps and
#             frequencies (the same messages from another sample rate or format)
#   pipe      the file is fed through a pipe in small writes (CHUNK bytes); stdout must equal EXPECTED
#   nolines   as gen, but the output must contain none of the strings in MUST_NOT (|-separated)
#   fail      run with ARGS and empty stdin: exit code must be 2, stdout empty, stderr must match STDERR_REGEX
#   empty     empty stdin: stdout must equal EXPECTED (hello + final stats line), exit 0
#   garbage   GARBAGE_BYTES of pseudo-random input: exit 0, at most MAX_LINES lines out
#   oddbyte   signal plus one stray byte: stdout equals EXPECTED, stderr mentions the cut-off sample
#   info      --foxsdr-helper-info output must equal the manifest file EXPECTED

if(NOT DEFINED NAME)
  set(NAME case)
endif()
if(NOT DEFINED CHUNK)
  set(CHUNK 777)
endif()
file(MAKE_DIRECTORY "${WORK}")
string(REPLACE "|" ";" ARGLIST "${ARGS}")
set(OUT "${WORK}/${NAME}.out")
set(ERR "${WORK}/${NAME}.err")

function(finish_compare out expected)
  if(DEFINED ENV{TC_UPDATE})
    configure_file("${out}" "${expected}" COPYONLY)
    message(STATUS "updated ${expected}")
    return()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${out}" "${expected}" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    file(READ "${out}" got)
    file(READ "${expected}" want)
    string(LENGTH "${got}" gl)
    string(LENGTH "${want}" wl)
    message(FATAL_ERROR "output differs from ${expected} (${gl} vs ${wl} bytes)\n--- got (first 4000) ---\n${got}\n--- expected (first 4000) ---\n${want}")
  endif()
endfunction()

function(run_helper in_file out_file err_file)
  execute_process(COMMAND "${HELPER}" ${ARGLIST} ${ARGN}
                  INPUT_FILE "${in_file}" OUTPUT_FILE "${out_file}" ERROR_FILE "${err_file}"
                  RESULT_VARIABLE rc)
  set(RC ${rc} PARENT_SCOPE)
endfunction()

# keep only the lines of the wanted types, without time stamp and frequency
function(strip in outf)
  file(STRINGS "${in}" ls)
  set(res "")
  foreach(l IN LISTS ls)
    foreach(ty IN LISTS TYPELIST)
      if(l MATCHES "\"type\":\"${ty}\"")
        string(REGEX REPLACE "^\\{\"t\":[0-9.]+," "{" l2 "${l}")
        string(REGEX REPLACE ",\"(cc_)?freq_hz\":[0-9]+" "" l2 "${l2}")
        string(APPEND res "${l2}\n")
      endif()
    endforeach()
  endforeach()
  file(WRITE "${outf}" "${res}")
endfunction()

set(NEEDS_SIGNAL TRUE)
if(MODE STREQUAL "fail" OR MODE STREQUAL "empty" OR MODE STREQUAL "garbage" OR MODE STREQUAL "info")
  set(NEEDS_SIGNAL FALSE)
endif()
if(NEEDS_SIGNAL)
  string(REPLACE "|" ";" GENLIST "${GEN}")
  list(GET GENLIST 0 g_scn)
  list(GET GENLIST 1 g_rate)
  list(GET GENLIST 2 g_fmt)
  list(REMOVE_AT GENLIST 0 1 2)
  execute_process(COMMAND "${TRUNKGEN}" ${g_scn} ${g_rate} ${g_fmt} "${WORK}/${NAME}.raw" ${GENLIST}
                  RESULT_VARIABLE grc ERROR_VARIABLE generr)
  if(NOT grc EQUAL 0)
    message(FATAL_ERROR "trunkgen failed (${grc}): ${generr}")
  endif()
  set(IN "${WORK}/${NAME}.raw")
endif()

if(MODE STREQUAL "gen")
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    file(READ "${ERR}" e)
    message(FATAL_ERROR "helper exited with ${RC}\n${e}")
  endif()
  run_helper("${IN}" "${OUT}.2" "${ERR}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}" "${OUT}.2" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    message(FATAL_ERROR "two runs on the same input gave different output")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "body")
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    file(READ "${ERR}" e)
    message(FATAL_ERROR "helper exited with ${RC}\n${e}")
  endif()
  file(STRINGS "${OUT}" lines)
  list(REMOVE_AT lines 0)
  list(JOIN lines "\n" body)
  file(WRITE "${OUT}.body" "${body}\n")
  file(STRINGS "${EXPECTED}" elines)
  list(REMOVE_AT elines 0)
  list(JOIN elines "\n" ebody)
  file(WRITE "${OUT}.ebody" "${ebody}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}.body" "${OUT}.ebody" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    message(FATAL_ERROR "events differ from ${EXPECTED} (hello line ignored)\n--- got ---\n${body}\n--- expected ---\n${ebody}")
  endif()

elseif(MODE STREQUAL "types")
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  string(REPLACE "|" ";" TYPELIST "${TYPES}")
  strip("${OUT}" "${OUT}.got")
  strip("${EXPECTED}" "${OUT}.want")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}.got" "${OUT}.want" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    file(READ "${OUT}.got" a)
    file(READ "${OUT}.want" b)
    message(FATAL_ERROR "decoded messages differ from ${EXPECTED}\n--- got ---\n${a}\n--- expected ---\n${b}")
  endif()

elseif(MODE STREQUAL "pipe")
  execute_process(COMMAND "${SIGTOOL}" feed "${IN}" ${CHUNK}
                  COMMAND "${HELPER}" ${ARGLIST}
                  OUTPUT_FILE "${OUT}" ERROR_FILE "${ERR}" RESULTS_VARIABLE rcs)
  list(GET rcs 1 rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "helper exited with ${rc} (feed: ${rcs})")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "nolines")
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  file(READ "${OUT}" o)
  string(REPLACE "|" ";" must "${MUST_NOT}")
  foreach(m IN LISTS must)
    string(FIND "${o}" "${m}" pos)
    if(NOT pos EQUAL -1)
      message(FATAL_ERROR "output contains '${m}':\n${o}")
    endif()
  endforeach()

elseif(MODE STREQUAL "fail")
  file(WRITE "${WORK}/empty.raw" "")
  run_helper("${WORK}/empty.raw" "${OUT}" "${ERR}")
  file(READ "${OUT}" o)
  file(READ "${ERR}" e)
  if(NOT RC EQUAL 2)
    message(FATAL_ERROR "expected exit code 2, got ${RC}\nstderr: ${e}")
  endif()
  if(NOT o STREQUAL "")
    message(FATAL_ERROR "expected nothing on stdout, got: ${o}")
  endif()
  if(NOT e MATCHES "${STDERR_REGEX}")
    message(FATAL_ERROR "stderr does not match '${STDERR_REGEX}':\n${e}")
  endif()

elseif(MODE STREQUAL "empty")
  file(WRITE "${WORK}/empty.raw" "")
  run_helper("${WORK}/empty.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on empty input")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "garbage")
  execute_process(COMMAND "${SIGTOOL}" garbage 12345 ${GARBAGE_BYTES} "${WORK}/${NAME}.raw" RESULT_VARIABLE grc)
  run_helper("${WORK}/${NAME}.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on garbage input")
  endif()
  execute_process(COMMAND "${SIGTOOL}" lines "${OUT}" OUTPUT_VARIABLE nlines OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(nlines GREATER MAX_LINES)
    message(FATAL_ERROR "garbage input produced ${nlines} lines (limit ${MAX_LINES})")
  endif()
  message(STATUS "garbage input: ${nlines} lines out")

elseif(MODE STREQUAL "oddbyte")
  execute_process(COMMAND "${SIGTOOL}" oddbyte "${IN}" "${WORK}/${NAME}.odd" RESULT_VARIABLE grc)
  run_helper("${WORK}/${NAME}.odd" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  file(READ "${ERR}" e)
  if(NOT e MATCHES "middle of a sample")
    message(FATAL_ERROR "no warning about the cut-off sample on stderr:\n${e}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "info")
  execute_process(COMMAND "${HELPER}" --foxsdr-helper-info OUTPUT_FILE "${OUT}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--foxsdr-helper-info exited with ${rc}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
