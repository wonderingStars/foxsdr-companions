# Regression test for trunkfmt: pipes generated signal files into the helper and compares the JSON Lines with
# the pinned files in tests/expected.  Run by CTest (see CMakeLists.txt) or by hand:
#   cmake -DHELPER=<trunkfmt.exe> -DGEN=<trunkfmt_gen.exe> -DSRC=<trunkfmt dir> -DWORK=<scratch dir> -P run_tests.cmake
# Set -DUPDATE=1 to rewrite the pinned files (review the diff by eye before committing them).
cmake_minimum_required(VERSION 3.20)
foreach(v HELPER GEN SRC WORK)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "missing -D${v}=")
  endif()
endforeach()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(failures 0)

function(fail msg)
  message(SEND_ERROR "FAIL: ${msg}")
  math(EXPR n "${failures} + 1")
  set(failures ${n} PARENT_SCOPE)
endfunction()

function(normalise var)
  string(REPLACE "\r\n" "\n" tmp "${${var}}")
  set(${var} "${tmp}" PARENT_SCOPE)
endfunction()

# run_case(<name> <input file> <expected stdout file name> <exit code expected 0|nonzero> [helper args...])
function(run_case name input expected want)
  set(args ${ARGN})
  if(input STREQUAL "")
    execute_process(COMMAND "${HELPER}" ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  else()
    execute_process(COMMAND "${HELPER}" ${args} INPUT_FILE "${input}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  endif()
  normalise(out)
  if(want STREQUAL "0")
    if(NOT rc EQUAL 0)
      fail("${name}: exit code ${rc}, wanted 0 (stderr: ${err})")
      return()
    endif()
  else()
    if(rc EQUAL 0)
      fail("${name}: exit code 0, wanted non-zero")
      return()
    endif()
    if(err STREQUAL "")
      fail("${name}: no message on stderr")
    endif()
  endif()
  if(expected STREQUAL "")
    return()
  endif()
  set(exp_file "${SRC}/tests/expected/${expected}")
  if(DEFINED UPDATE)
    file(WRITE "${exp_file}" "${out}")
    message(STATUS "updated ${exp_file}")
    return()
  endif()
  file(READ "${exp_file}" exp)
  normalise(exp)
  if(NOT out STREQUAL exp)
    file(WRITE "${WORK}/${name}.actual" "${out}")
    fail("${name}: output differs from tests/expected/${expected} (actual written to ${WORK}/${name}.actual)")
  else()
    message(STATUS "ok: ${name}")
  endif()
endfunction()

# generate the signals
execute_process(COMMAND "${GEN}" "${WORK}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "generator failed: ${rc}")
endif()

set(A --foxsdr-helper 1 --format s16)
run_case(lj_8k          "${WORK}/lj.s16"        lj_8k.jsonl        0 ${A} --rate 8000)
run_case(lj_f32         "${WORK}/lj.f32"        lj_8k.jsonl        0 --foxsdr-helper 1 --format f32 --rate 8000)
run_case(lj_48k         "${WORK}/lj_48k.s16"    lj_48k.jsonl       0 ${A} --rate 48000)
run_case(lj_noisy       "${WORK}/lj_noisy.s16"  lj_noisy.jsonl     0 ${A} --rate 8000)
run_case(tait_8k        "${WORK}/tait.s16"      tait_8k.jsonl      0 ${A} --rate 8000)
run_case(lj_only_filter "${WORK}/tait.s16"      tait_lj_only.jsonl 0 ${A} --rate 8000 --decoders lj1200)
run_case(fleetsync_8k   "${WORK}/fleetsync.s16"  fleetsync_8k.jsonl  0 ${A} --rate 8000)
run_case(mpt1327_8k     "${WORK}/mpt1327.s16"    mpt1327_8k.jsonl    0 ${A} --rate 8000)
run_case(ltr_8k          "${WORK}/ltr.s16"        ltr_8k.jsonl        0 ${A} --rate 8000 --decoders ltr)
run_case(ltrnet_8k       "${WORK}/ltrnet.s16"     ltrnet_8k.jsonl     0 ${A} --rate 8000 --decoders ltrnet)
run_case(ltr_48k         "${WORK}/ltr_48k.s16"    ltr_48k.jsonl       0 ${A} --rate 48000 --decoders ltr)
run_case(passport_8k     "${WORK}/passport.s16"   passport_8k.jsonl   0 ${A} --rate 8000 --decoders passport)
run_case(csbk_hex       "${WORK}/csbk.txt"      csbk_hex.jsonl     0 --foxsdr-helper 1 --format csbk-hex)

# failure paths
file(WRITE "${WORK}/empty.bin" "")
run_case(empty_input    "${WORK}/empty.bin"     empty.jsonl        0 ${A} --rate 8000)
run_case(empty_csbk     "${WORK}/empty.bin"     empty_csbk.jsonl   0 --foxsdr-helper 1 --format csbk-hex)
run_case(garbage        "${WORK}/garbage.s16"   garbage.jsonl      0 ${A} --rate 8000)
run_case(garbage_as_text "${WORK}/garbage.s16"  garbage_csbk.jsonl 0 --foxsdr-helper 1 --format csbk-hex)
run_case(bad_format     "${WORK}/empty.bin"     ""                 nonzero --foxsdr-helper 1 --format wav --rate 8000)
run_case(no_rate        "${WORK}/empty.bin"     ""                 nonzero ${A})
run_case(bad_protocol   "${WORK}/empty.bin"     ""                 nonzero --foxsdr-helper 2 --format s16 --rate 8000)
run_case(bad_decoder    "${WORK}/empty.bin"     ""                 nonzero ${A} --rate 8000 --decoders nosuch)

# a wrong format must not print anything on stdout (no hello line)
execute_process(COMMAND "${HELPER}" --foxsdr-helper 1 --format wav --rate 8000 INPUT_FILE "${WORK}/empty.bin"
                OUTPUT_VARIABLE o2 ERROR_QUIET RESULT_VARIABLE rc2)
if(NOT o2 STREQUAL "")
  fail("bad_format: wrote to stdout: ${o2}")
endif()

# same input twice gives the same bytes
execute_process(COMMAND "${HELPER}" ${A} --rate 8000 INPUT_FILE "${WORK}/lj_noisy.s16" OUTPUT_VARIABLE r1)
execute_process(COMMAND "${HELPER}" ${A} --rate 8000 INPUT_FILE "${WORK}/lj_noisy.s16" OUTPUT_VARIABLE r2)
if(NOT r1 STREQUAL r2)
  fail("determinism: two runs differ")
endif()

# manifest printed by --foxsdr-helper-info is the checked-in file
execute_process(COMMAND "${HELPER}" --foxsdr-helper-info OUTPUT_VARIABLE info RESULT_VARIABLE rc3)
file(READ "${SRC}/trunkfmt.helper.json" man)
normalise(info)
normalise(man)
if(NOT rc3 EQUAL 0 OR NOT info STREQUAL man)
  fail("manifest: --foxsdr-helper-info differs from trunkfmt.helper.json")
endif()

if(failures GREATER 0)
  message(FATAL_ERROR "${failures} test(s) failed")
endif()
message(STATUS "all trunkfmt tests passed")
