# Test driver for the packet helper: one script, several modes (-DMODE=...), run by CTest as
#   cmake -DMODE=... -DHELPER=... [-DARGS=a|b|c] [-DGENTOOL=... -DGENARGS=a|b] [-DEXPECTED=...] -P run_case.cmake
# ARGS are helper arguments separated by '|' (CTest cannot pass lists with ';' reliably).
# Set the environment variable PK_UPDATE=1 to rewrite EXPECTED from the current output instead of comparing
# (review the git diff before committing it).
#
# MODE
#   gen       GENTOOL (gen_packets, or gen_damaged with DAMAGE=x9 etc.) makes WORK/NAME.wav from MSGS with GENARGS
#             (separated by '|'), RAWTOOL turns it into WORK/NAME.raw; the helper reads it. Stdout must equal EXPECTED
#             byte for byte, exit code 0, and a second run must give the identical output (determinism).
#   concat    INPUTS (separated by '|': names of earlier .raw files in WORK) joined, then as compare
#   pipe      the gen'd file fed through a pipe in CHUNK byte writes: must equal EXPECTED
#   f32       the gen'd file converted to float samples, run with --format f32: events must equal EXPECTED's
#   fail      run with ARGS: exit code must be 2, stdout empty, stderr must match STDERR_REGEX
#   empty     empty stdin: stdout is exactly the hello line and the stats line (EXPECTED), exit code 0
#   garbage   GARBAGE_BYTES of pseudo-random input: exit code 0, at most MAX_LINES lines out, no crash
#   noise     NOISE_SAMPLES of loud wide-band noise as s16 audio: as garbage
#   silence   SILENCE_SAMPLES zero samples: stdout equals EXPECTED
#   oddbyte   the gen'd file plus one stray byte: stdout equals EXPECTED, stderr mentions the cut-off sample
#   info      --foxsdr-helper-info output must equal the manifest file EXPECTED
#   hello     hello line (first stdout line) must contain every |-separated string in MUST_CONTAIN

if(NOT DEFINED NAME)
  set(NAME case)
endif()
if(NOT DEFINED CHUNK)
  set(CHUNK 777)
endif()
if(NOT DEFINED RATE)
  set(RATE 44100)
endif()
file(MAKE_DIRECTORY "${WORK}")
string(REPLACE "|" ";" ARGLIST "${ARGS}")
set(OUT "${WORK}/${NAME}.out")
set(ERR "${WORK}/${NAME}.err")

function(finish_compare out expected)
  if(DEFINED ENV{PK_UPDATE})
    configure_file("${out}" "${expected}" COPYONLY)
    message(STATUS "updated ${expected}")
    return()
  endif()
  if(NOT EXISTS "${expected}")
    message(FATAL_ERROR "no pinned expectation ${expected} (run with PK_UPDATE=1 once and review it)")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${out}" "${expected}" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    file(READ "${out}" got)
    file(READ "${expected}" want)
    string(LENGTH "${got}" gl)
    string(LENGTH "${want}" wl)
    message(FATAL_ERROR "output differs from ${expected} (${gl} vs ${wl} bytes)\n--- got ---\n${got}\n--- expected ---\n${want}")
  endif()
endfunction()

function(run_helper in_file out_file err_file)
  execute_process(COMMAND "${HELPER}" ${ARGLIST} ${ARGN}
                  INPUT_FILE "${in_file}" OUTPUT_FILE "${out_file}" ERROR_FILE "${err_file}"
                  RESULT_VARIABLE rc)
  set(RC ${rc} PARENT_SCOPE)
endfunction()

# make WORK/NAME.raw from the generator
function(make_signal)
  string(REPLACE "|" ";" GENLIST "${GENARGS}")
  file(REMOVE "${WORK}/${NAME}.wav")
  if(DEFINED DAMAGE)
    set(ENV{DW_DAMAGE} "${DAMAGE}")
  else()
    unset(ENV{DW_DAMAGE})
  endif()
  # with -n the generator makes its own text and refuses a message file
  list(FIND GENLIST "-n" has_n)
  if(has_n EQUAL -1)
    set(msgs_arg "${MSGS}")
  else()
    set(msgs_arg "")
  endif()
  execute_process(COMMAND "${GENTOOL}" ${GENLIST} -o "${WORK}/${NAME}.wav" ${msgs_arg}
                  OUTPUT_QUIET ERROR_VARIABLE generr RESULT_VARIABLE grc)
  if(NOT grc EQUAL 0 OR NOT EXISTS "${WORK}/${NAME}.wav")
    message(FATAL_ERROR "generator failed (${grc}): ${generr}")
  endif()
  execute_process(COMMAND "${RAWTOOL}" wav2raw "${WORK}/${NAME}.wav" "${WORK}/${NAME}.raw" OUTPUT_QUIET RESULT_VARIABLE rrc)
  if(NOT rrc EQUAL 0)
    message(FATAL_ERROR "rawtool wav2raw failed")
  endif()
endfunction()

if(MODE STREQUAL "gen")
  make_signal()
  run_helper("${WORK}/${NAME}.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    file(READ "${ERR}" e)
    message(FATAL_ERROR "helper exited with ${RC}\n${e}")
  endif()
  run_helper("${WORK}/${NAME}.raw" "${OUT}.2" "${ERR}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}" "${OUT}.2" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    message(FATAL_ERROR "two runs on the same input gave different output (${OUT} vs ${OUT}.2)")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "concat")
  # PARTS: names; for each, ${part}_ARGS (generator args, |-separated), optional ${part}_DAMAGE. One stream of all of them.
  set(joined "${WORK}/${NAME}.raw")
  file(REMOVE "${joined}")
  string(REPLACE "|" ";" PARTLIST "${PARTS}")
  set(pieces "")
  foreach(p IN LISTS PARTLIST)
    set(GENARGS "${${p}_ARGS}")
    set(DAMAGE "${${p}_DAMAGE}")
    if(DAMAGE STREQUAL "")
      unset(DAMAGE)
    endif()
    set(NAME_SAVE "${NAME}")
    set(NAME "${NAME_SAVE}_${p}")
    make_signal()
    set(NAME "${NAME_SAVE}")
    list(APPEND pieces "${WORK}/${NAME}_${p}.raw")
  endforeach()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E cat ${pieces} OUTPUT_FILE "${joined}" RESULT_VARIABLE crc)
  if(NOT crc EQUAL 0)
    message(FATAL_ERROR "cmake -E cat failed")
  endif()
  run_helper("${joined}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "pipe")
  make_signal()
  execute_process(COMMAND "${RAWTOOL}" feed "${WORK}/${NAME}.raw" ${CHUNK}
                  COMMAND "${HELPER}" ${ARGLIST}
                  OUTPUT_FILE "${OUT}" ERROR_FILE "${ERR}" RESULTS_VARIABLE rcs)
  list(GET rcs 1 rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "helper exited with ${rc} (feed: ${rcs})")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "f32")
  string(REPLACE "|" ";" GENLIST "${GENARGS}")
  file(REMOVE "${WORK}/${NAME}.wav")
  execute_process(COMMAND "${GENTOOL}" ${GENLIST} -o "${WORK}/${NAME}.wav" "${MSGS}" OUTPUT_QUIET RESULT_VARIABLE grc)
  execute_process(COMMAND "${RAWTOOL}" wav2raw -f32 "${WORK}/${NAME}.wav" "${WORK}/${NAME}.f32" OUTPUT_QUIET RESULT_VARIABLE rrc)
  if(NOT grc EQUAL 0 OR NOT rrc EQUAL 0)
    message(FATAL_ERROR "signal generation failed")
  endif()
  # the helper takes the last --format it is given, so appending f32 overrides the s16 in ARGS
  string(REPLACE "|" ";" ARGLIST "${ARGS}|--format|f32")
  run_helper("${WORK}/${NAME}.f32" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  # the hello line names the format, so compare from line 2 on
  file(STRINGS "${OUT}" lines)
  list(REMOVE_AT lines 0)
  list(JOIN lines "\n" body)
  file(WRITE "${OUT}.body" "${body}\n")
  file(STRINGS "${EXPECTED}" elines)
  list(REMOVE_AT elines 0)
  list(JOIN elines "\n" ebody)
  file(WRITE "${OUT}.ebody" "${ebody}\n")
  finish_compare("${OUT}.body" "${OUT}.ebody")

elseif(MODE STREQUAL "fail")
  file(WRITE "${WORK}/empty.raw" "")
  run_helper("${WORK}/empty.raw" "${OUT}" "${ERR}")
  file(READ "${OUT}" o)
  file(READ "${ERR}" e)
  if(NOT RC EQUAL 2)
    message(FATAL_ERROR "expected exit code 2, got ${RC}\nstderr: ${e}")
  endif()
  if(NOT o STREQUAL "")
    message(FATAL_ERROR "expected nothing on stdout, got: ${o}")
  endif()
  if(NOT e MATCHES "${STDERR_REGEX}")
    message(FATAL_ERROR "stderr does not match '${STDERR_REGEX}':\n${e}")
  endif()

elseif(MODE STREQUAL "empty")
  file(WRITE "${WORK}/empty.raw" "")
  run_helper("${WORK}/empty.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on empty input")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "garbage" OR MODE STREQUAL "noise")
  if(MODE STREQUAL "garbage")
    execute_process(COMMAND "${RAWTOOL}" garbage 12345 ${GARBAGE_BYTES} "${WORK}/${NAME}.raw" RESULT_VARIABLE grc)
  else()
    execute_process(COMMAND "${RAWTOOL}" noise 4242 ${NOISE_SAMPLES} "${WORK}/${NAME}.raw" RESULT_VARIABLE grc)
  endif()
  run_helper("${WORK}/${NAME}.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on ${MODE} input")
  endif()
  execute_process(COMMAND "${RAWTOOL}" lines "${OUT}" OUTPUT_VARIABLE nlines OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(nlines GREATER MAX_LINES)
    message(FATAL_ERROR "${MODE} input produced ${nlines} lines (limit ${MAX_LINES})")
  endif()
  message(STATUS "${MODE} input: ${nlines} lines out")

elseif(MODE STREQUAL "silence")
  execute_process(COMMAND "${RAWTOOL}" silence ${SILENCE_SAMPLES} "${WORK}/${NAME}.raw" RESULT_VARIABLE grc)
  run_helper("${WORK}/${NAME}.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "oddbyte")
  make_signal()
  execute_process(COMMAND "${RAWTOOL}" oddbyte "${WORK}/${NAME}.raw" "${WORK}/${NAME}.odd" RESULT_VARIABLE grc)
  run_helper("${WORK}/${NAME}.odd" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  file(READ "${ERR}" e)
  if(NOT e MATCHES "middle of a sample")
    message(FATAL_ERROR "no warning about the cut-off sample on stderr:\n${e}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "info")
  execute_process(COMMAND "${HELPER}" --foxsdr-helper-info OUTPUT_FILE "${OUT}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--foxsdr-helper-info exited with ${rc}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "hello")
  file(WRITE "${WORK}/empty.raw" "")
  run_helper("${WORK}/empty.raw" "${OUT}" "${ERR}")
  file(STRINGS "${OUT}" lines)
  list(GET lines 0 hello)
  string(REPLACE "|" ";" must "${MUST_CONTAIN}")
  foreach(m IN LISTS must)
    string(FIND "${hello}" "${m}" pos)
    if(pos EQUAL -1)
      message(FATAL_ERROR "hello line lacks ${m}: ${hello}")
    endif()
  endforeach()

elseif(MODE STREQUAL "real")
  # A real off-air recording kept outside the repository (FOXSDR_SAMPLES_DIR, optional): skipped (exit 77) when the file or
  # ffmpeg is not there. Only the counts are pinned, never any text from the recording. SRC = recording, SECONDS = how much.
  find_program(FFMPEG ffmpeg)
  if(NOT EXISTS "${SRC}" OR NOT FFMPEG)
    message(STATUS "skipped: ${SRC} or ffmpeg not available")
    cmake_language(EXIT 77)
  endif()
  execute_process(COMMAND "${FFMPEG}" -v error -y -i "${SRC}" -t ${SECONDS} -af "pan=mono|c0=c0" -f s16le -ar ${RATE}
                  "${WORK}/${NAME}.raw" RESULT_VARIABLE frc)
  if(NOT frc EQUAL 0)
    message(FATAL_ERROR "ffmpeg failed")
  endif()
  run_helper("${WORK}/${NAME}.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  file(STRINGS "${OUT}" lines)
  list(GET lines -1 last)
  string(REGEX REPLACE "^.*\"samples\":([0-9]+),\"frames\":([0-9]+),\"ax25\":([0-9]+),\"fx25\":([0-9]+),\"il2p\":([0-9]+).*$" "samples=\\1 frames=\\2 ax25=\\3 fx25=\\4 il2p=\\5" counts "${last}")
  file(WRITE "${OUT}.counts" "${counts}")
  finish_compare("${OUT}.counts" "${EXPECTED}")

else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
