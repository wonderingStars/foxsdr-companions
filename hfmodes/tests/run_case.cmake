# Pipes a signal file into the helper and compares the JSON Lines with the pinned expectation (exact match).
# -DHELPER -DINPUT -DRATE -DMODES (empty = all modes) -DEXPECT -DACTUAL ; -DPIN=1 writes the expectation instead of comparing.
set(args --foxsdr-helper 1 --format s16 --rate ${RATE})
if(MODES)
  list(APPEND args --modes ${MODES})
endif()
execute_process(COMMAND ${HELPER} ${args} INPUT_FILE ${INPUT} OUTPUT_FILE ${ACTUAL} ERROR_VARIABLE err RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "helper exited with ${rc}: ${err}")
endif()
if(PIN)
  file(COPY_FILE ${ACTUAL} ${EXPECT})
  message(STATUS "pinned ${EXPECT}")
  return()
endif()
if(NOT EXISTS ${EXPECT})
  message(FATAL_ERROR "no pinned expectation ${EXPECT}")
endif()
# the decoded text must be what the generator sent (WANT, or the contents of WANT_FILE); text events are chunks, so they are joined first
if(WANT_FILE)
  file(READ ${WANT_FILE} WANT)
endif()
if(WANT)
  file(STRINGS ${ACTUAL} lines)
  set(joined "")
  set(other "")
  foreach(l IN LISTS lines)
    string(JSON type ERROR_VARIABLE e GET "${l}" type)
    string(JSON txt ERROR_VARIABLE e2 GET "${l}" text)
    if(NOT e AND NOT e2)
      if(type STREQUAL "text")
        string(APPEND joined "${txt}")
      else()
        string(APPEND other "${txt}
")
      endif()
    endif()
  endforeach()
  string(REGEX REPLACE " +" " " joined "${joined}")
  string(REGEX REPLACE " +" " " want1 "${WANT}")
  string(STRIP "${want1}" want1)
  string(FIND "${joined}" "${want1}" p1)
  string(FIND "${other}" "${want1}" p2)
  if(p1 EQUAL -1 AND p2 EQUAL -1)
    message(FATAL_ERROR "expected text not found: '${want1}'
decoded text: ${joined}")
  endif()
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${ACTUAL} ${EXPECT} RESULT_VARIABLE same)
if(NOT same EQUAL 0)
  file(STRINGS ${ACTUAL} a)
  file(STRINGS ${EXPECT} e)
  list(LENGTH a na)
  list(LENGTH e ne)
  message(STATUS "actual ${na} lines, expected ${ne} lines")
  set(i 0)
  foreach(x IN LISTS a)
    list(LENGTH e ne2)
    if(i LESS ne2)
      list(GET e ${i} y)
    else()
      set(y "<missing>")
    endif()
    if(NOT "${x}" STREQUAL "${y}")
      message(FATAL_ERROR "first difference at line ${i}:\n actual:   ${x}\n expected: ${y}")
    endif()
    math(EXPR i "${i}+1")
  endforeach()
  message(FATAL_ERROR "output differs (length or line endings) from ${EXPECT}")
endif()
