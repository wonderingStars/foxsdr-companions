# --foxsdr-helper-info prints the manifest, and it equals hfmodes.helper.json
execute_process(COMMAND ${HELPER} --foxsdr-helper-info OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "exit ${rc}")
endif()
file(READ ${MANIFEST} want)
string(STRIP "${out}" out)
string(STRIP "${want}" want)
if(NOT out STREQUAL want)
  message(FATAL_ERROR "manifest differs:\n${out}\n${want}")
endif()
string(JSON name GET "${out}" name)
string(JSON lic GET "${out}" licence)
string(JSON n LENGTH "${out}" modes)
if(NOT name STREQUAL "hfmodes" OR NOT lic STREQUAL "GPL-3.0-or-later" OR NOT n EQUAL 20)
  message(FATAL_ERROR "manifest fields: ${name} ${lic} ${n} modes")
endif()
