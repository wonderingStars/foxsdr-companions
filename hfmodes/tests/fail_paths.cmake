# Failure paths: empty input, garbage input, a wrong --format, a missing protocol argument, a bad rate, an unknown mode.
# -DHELPER -DSIG (a writable folder) -DGEN (hfmodes_gen)
function(fail msg)
  message(FATAL_ERROR "${msg}")
endfunction()

# 1. empty input: the hello line, then exit 0 (and at most the closing stats line)
file(WRITE ${SIG}/empty.raw "")
execute_process(COMMAND ${HELPER} --foxsdr-helper 1 --format s16 --rate 48000 INPUT_FILE ${SIG}/empty.raw OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  fail("empty input: exit ${rc}")
endif()
string(REGEX MATCHALL "[^\n]+" lines "${out}")
list(LENGTH lines n)
list(GET lines 0 hello)
if(n GREATER 2 OR NOT hello MATCHES "^\{\"helper\":\"hfmodes\",\"version\":\"[0-9.]+\",\"protocol\":1,")
  fail("empty input: ${n} lines, first: ${hello}")
endif()

# 2. garbage input, read as s16 and as f32: exit 0, no flood of output
execute_process(COMMAND ${GEN} --case garbage --rate 8000 --out ${SIG}/garbage.raw RESULT_VARIABLE grc)
if(NOT grc EQUAL 0)
  fail("generator failed")
endif()
foreach(fmt s16 f32)
  execute_process(COMMAND ${HELPER} --foxsdr-helper 1 --format ${fmt} --rate 44100 INPUT_FILE ${SIG}/garbage.raw OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    fail("garbage as ${fmt}: exit ${rc}")
  endif()
  string(REGEX MATCHALL "[^\n]+" lines "${out}")
  list(LENGTH lines n)
  if(n GREATER 60)
    fail("garbage as ${fmt}: ${n} output lines (a flood)")
  endif()
  foreach(l IN LISTS lines)
    string(JSON t ERROR_VARIABLE jerr TYPE "${l}")
    if(NOT t STREQUAL "OBJECT")
      fail("garbage as ${fmt}: not a JSON object: ${l} (${jerr})")
    endif()
  endforeach()
endforeach()

# 3. wrong --format: non-zero exit, a message on stderr, nothing on stdout
foreach(fmt cs16 cf32 u8 "")
  execute_process(COMMAND ${HELPER} --foxsdr-helper 1 --format ${fmt} --rate 48000 INPUT_FILE ${SIG}/empty.raw OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(rc EQUAL 0 OR NOT err MATCHES "--format" OR NOT out STREQUAL "")
    fail("--format '${fmt}': exit ${rc}, stderr '${err}', stdout '${out}'")
  endif()
endforeach()

# 4. missing protocol argument, bad rate, unknown mode
foreach(bad "--format;s16;--rate;48000" "--foxsdr-helper;1;--format;s16;--rate;100" "--foxsdr-helper;1;--format;s16;--rate;48000;--modes;NOPE" "--foxsdr-helper;2;--format;s16;--rate;48000")
  execute_process(COMMAND ${HELPER} ${bad} INPUT_FILE ${SIG}/empty.raw OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(rc EQUAL 0 OR err STREQUAL "" OR NOT out STREQUAL "")
    fail("'${bad}': exit ${rc}, stderr '${err}', stdout '${out}'")
  endif()
endforeach()

# 5. the attribution line OnAir's additional terms require is in --version and --help
foreach(opt --version --help)
  execute_process(COMMAND ${HELPER} ${opt} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0 OR NOT out MATCHES "Based on OnAir by Kristijonas Adomaitis - https://on-air.dev")
    fail("${opt}: attribution line missing: ${out}")
  endif()
endforeach()
message(STATUS "failure paths ok")
