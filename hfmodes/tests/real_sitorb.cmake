# Optional: a REAL off-air SITOR-B recording (sigidwiki SITOR-B_tfc.mp3, kept in FOXSDR_SAMPLES_DIR, never committed) converted by the
# ffmpeg found on the PATH. Skipped (exit 77) where the file or ffmpeg is missing. -DHELPER -DSAMPLE -DWORK
find_program(FFMPEG ffmpeg)
if(NOT EXISTS ${SAMPLE} OR NOT FFMPEG)
  message(STATUS "real recording or ffmpeg not available: skipped")
  cmake_language(EXIT 77)
endif()
execute_process(COMMAND ${FFMPEG} -v error -y -i ${SAMPLE} -ac 1 -ar 44100 -f s16le ${WORK}/real_sitorb_tfc.raw RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "ffmpeg failed")
endif()
execute_process(COMMAND ${HELPER} --foxsdr-helper 1 --format s16 --rate 44100 --modes SITOR-B INPUT_FILE ${WORK}/real_sitorb_tfc.raw OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "helper exit ${rc}")
endif()
string(REGEX MATCHALL "\"text\":\"[^\"]*\"" parts "${out}")
set(joined "")
foreach(p IN LISTS parts)
  string(REGEX REPLACE "^.text.:.(.*).$" "\\1" t "${p}")
  string(APPEND joined "${t}")
endforeach()
foreach(want "ZCZC" "CQ DE OST QTC LIST" "IN FEC MODE")
  string(FIND "${joined}" "${want}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "real SITOR-B: '${want}' not in decoded text: ${joined}")
  endif()
endforeach()
message(STATUS "real SITOR-B recording decoded: ${joined}")
