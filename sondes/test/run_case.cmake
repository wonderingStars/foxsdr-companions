# Test driver for the sondes helper, run by CTest as
#   cmake -DMODE=... -DHELPER=... -DGENTOOL=... [-DGEN_ARGS=a|b|c] [-DARGS=a|b|c] [-DEXPECTED=...] -P run_case.cmake
# List arguments are separated by '|' (CTest cannot pass ';' lists reliably).
# Set the environment variable SONDES_UPDATE=1 to rewrite EXPECTED from the current output instead of comparing
# (review the git diff before committing it).
#
# MODE
#   signal    GEN_ARGS (sondes-gen arguments) make WORK/NAME.raw and NAME.truth; the helper runs on it twice (the two
#             outputs must be identical), stdout must equal EXPECTED, and the truth file must match the sonde events
#             (sondes-gen check) unless NOCHECK is set
#   mixed     INPUTS (names of other cases, already generated by a signal case) are concatenated; as signal
#   f32       as signal, with --f32 and --format f32: the events (lines after the hello) must equal EXPECTED's
#   chunk     as signal, with --chunk 777: the sorted lines (minus the hello) must equal the default run's
#   empty     empty stdin: stdout is exactly the hello line (EXPECTED), exit code 0
#   garbage   GARBAGE_BYTES of pseudo-random input: exit code 0, at most MAX_LINES lines out
#   fail      ARGS only: exit code 2, empty stdout, stderr matches STDERR_REGEX
#   info      --foxsdr-helper-info output equals the manifest file EXPECTED
#   hello     the hello line contains every |-separated string of MUST_CONTAIN

if(NOT DEFINED NAME)
  set(NAME case)
endif()
file(MAKE_DIRECTORY "${WORK}")
string(REPLACE "|" ";" ARGLIST "${ARGS}")
set(OUT "${WORK}/${NAME}.out")
set(ERR "${WORK}/${NAME}.err")

function(finish_compare out expected)
  if(DEFINED ENV{SONDES_UPDATE})
    configure_file("${out}" "${expected}" COPYONLY)
    message(STATUS "updated ${expected}")
    return()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${out}" "${expected}" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    file(READ "${out}" got)
    file(READ "${expected}" want)
    message(FATAL_ERROR "output differs from ${expected}\n--- got ---\n${got}\n--- expected ---\n${want}")
  endif()
endfunction()

function(run_helper in_file out_file err_file)
  execute_process(COMMAND "${HELPER}" ${ARGLIST} ${ARGN}
                  INPUT_FILE "${in_file}" OUTPUT_FILE "${out_file}" ERROR_FILE "${err_file}"
                  RESULT_VARIABLE rc)
  set(RC ${rc} PARENT_SCOPE)
endfunction()

# the file without its first line (the hello), optionally sorted
function(body_of in out sorted)
  file(STRINGS "${in}" lines)
  list(REMOVE_AT lines 0)
  if(sorted)
    list(SORT lines)
  endif()
  list(JOIN lines "\n" b)
  file(WRITE "${out}" "${b}\n")
endfunction()

function(make_signal)
  if(MODE STREQUAL "mixed")
    set(parts "")
    string(REPLACE "|" ";" INLIST "${INPUTS}")
    foreach(i IN LISTS INLIST)
      list(APPEND parts "${WORK}/${i}.raw")
    endforeach()
    execute_process(COMMAND "${GENTOOL}" cat "${WORK}/${NAME}.raw" ${parts} RESULT_VARIABLE grc)
    if(NOT grc EQUAL 0)
      message(FATAL_ERROR "sondes-gen cat failed")
    endif()
    file(WRITE "${WORK}/${NAME}.truth" "")
    foreach(i IN LISTS INLIST)
      file(READ "${WORK}/${i}.truth" t)
      file(APPEND "${WORK}/${NAME}.truth" "${t}")
    endforeach()
  else()
    string(REPLACE "|" ";" GENLIST "${GEN_ARGS}")
    set(f32arg "")
    if(MODE STREQUAL "f32")
      set(f32arg --f32)
    endif()
    execute_process(COMMAND "${GENTOOL}" ${GENLIST} ${f32arg} --out "${WORK}/${NAME}.raw" --truth "${WORK}/${NAME}.truth"
                    RESULT_VARIABLE grc ERROR_VARIABLE generr)
    if(NOT grc EQUAL 0)
      message(FATAL_ERROR "sondes-gen failed (${grc}): ${generr}")
    endif()
  endif()
endfunction()

if(MODE STREQUAL "signal" OR MODE STREQUAL "mixed")
  make_signal()
  run_helper("${WORK}/${NAME}.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    file(READ "${ERR}" e)
    message(FATAL_ERROR "helper exited with ${RC}\n${e}")
  endif()
  run_helper("${WORK}/${NAME}.raw" "${OUT}.2" "${ERR}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}" "${OUT}.2" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    message(FATAL_ERROR "two runs on the same input gave different output (${OUT} vs ${OUT}.2)")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")
  if(NOT NOCHECK)
    execute_process(COMMAND "${GENTOOL}" check "${WORK}/${NAME}.truth" "${OUT}" RESULT_VARIABLE crc ERROR_VARIABLE cerr)
    if(NOT crc EQUAL 0)
      message(FATAL_ERROR "decoded events do not match what the generator put in:\n${cerr}")
    endif()
  endif()

elseif(MODE STREQUAL "f32")
  make_signal()
  string(REPLACE "|" ";" ARGLIST "${ARGS}|--format|f32")   # the helper takes the last --format it is given
  run_helper("${WORK}/${NAME}.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  body_of("${OUT}" "${OUT}.body" FALSE)
  body_of("${EXPECTED}" "${OUT}.ebody" FALSE)
  finish_compare("${OUT}.body" "${OUT}.ebody")
  execute_process(COMMAND "${GENTOOL}" check "${WORK}/${NAME}.truth" "${OUT}" RESULT_VARIABLE crc ERROR_VARIABLE cerr)
  if(NOT crc EQUAL 0)
    message(FATAL_ERROR "float input: events do not match the generator:\n${cerr}")
  endif()

elseif(MODE STREQUAL "chunk")
  make_signal()
  run_helper("${WORK}/${NAME}.raw" "${OUT}" "${ERR}")
  run_helper("${WORK}/${NAME}.raw" "${OUT}.c" "${ERR}" --chunk 777)
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  # a run that finds nothing would also be "equal": the default run must match what the generator put in
  execute_process(COMMAND "${GENTOOL}" check "${WORK}/${NAME}.truth" "${OUT}" RESULT_VARIABLE crc ERROR_VARIABLE cerr)
  if(NOT crc EQUAL 0)
    message(FATAL_ERROR "chunk case: default run does not match the generator:\n${cerr}")
  endif()
  body_of("${OUT}" "${OUT}.s" TRUE)
  body_of("${OUT}.c" "${OUT}.cs" TRUE)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}.s" "${OUT}.cs" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    file(READ "${OUT}.s" a)
    file(READ "${OUT}.cs" b)
    message(FATAL_ERROR "decoded events depend on the input chunk size\n--- default ---\n${a}\n--- chunk 777 ---\n${b}")
  endif()

elseif(MODE STREQUAL "empty")
  file(WRITE "${WORK}/empty.raw" "")
  run_helper("${WORK}/empty.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on empty input")
  endif()
  file(STRINGS "${OUT}" lines)
  list(LENGTH lines n)
  if(NOT n EQUAL 2)
    message(FATAL_ERROR "empty input: expected the hello and the final stats line, got ${n} lines")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "garbage")
  execute_process(COMMAND "${GENTOOL}" garbage 12345 ${GARBAGE_BYTES} "${WORK}/${NAME}.raw" RESULT_VARIABLE grc)
  run_helper("${WORK}/${NAME}.raw" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on garbage input")
  endif()
  execute_process(COMMAND "${GENTOOL}" lines "${OUT}" OUTPUT_VARIABLE nlines OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(nlines GREATER MAX_LINES)
    message(FATAL_ERROR "garbage input produced ${nlines} lines (limit ${MAX_LINES})")
  endif()
  message(STATUS "garbage input: ${nlines} lines out")

elseif(MODE STREQUAL "fail")
  file(WRITE "${WORK}/empty.raw" "")
  run_helper("${WORK}/empty.raw" "${OUT}" "${ERR}")
  file(READ "${OUT}" o)
  file(READ "${ERR}" e)
  if(NOT RC EQUAL 2)
    message(FATAL_ERROR "expected exit code 2, got ${RC}\nstderr: ${e}")
  endif()
  if(NOT o STREQUAL "")
    message(FATAL_ERROR "expected nothing on stdout, got: ${o}")
  endif()
  if(NOT e MATCHES "${STDERR_REGEX}")
    message(FATAL_ERROR "stderr does not match '${STDERR_REGEX}':\n${e}")
  endif()

elseif(MODE STREQUAL "info")
  execute_process(COMMAND "${HELPER}" --foxsdr-helper-info OUTPUT_FILE "${OUT}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--foxsdr-helper-info exited with ${rc}")
  endif()
  # the manifest in compact form, as the program prints it
  file(READ "${EXPECTED}" m)
  string(REGEX REPLACE "[ \t\r\n]+" " " m "${m}")
  string(STRIP "${m}" m)
  file(READ "${OUT}" o)
  string(STRIP "${o}" o)
  if(NOT o STREQUAL m)
    message(FATAL_ERROR "manifest printed by the program differs from sondes.helper.json\n${o}\n${m}")
  endif()

elseif(MODE STREQUAL "hello")
  file(WRITE "${WORK}/empty.raw" "")
  run_helper("${WORK}/empty.raw" "${OUT}" "${ERR}")
  file(STRINGS "${OUT}" lines)
  list(GET lines 0 hello)
  string(REPLACE "|" ";" must "${MUST_CONTAIN}")
  foreach(m IN LISTS must)
    string(FIND "${hello}" "${m}" pos)
    if(pos EQUAL -1)
      message(FATAL_ERROR "hello line lacks ${m}: ${hello}")
    endif()
  endforeach()

else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
