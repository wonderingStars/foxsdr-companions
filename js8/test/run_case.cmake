# Runs one test case of the js8 helper. Called by ctest through test/CMakeLists.txt with -D variables:
#   HELPER, GEN (js8gen), WORK (scratch dir), NAME, MODE, ARGS (helper options, '|' separated), EXPECTED (pinned file),
#   and optionally  WAV (a .wav to convert to raw s16 first), GENARGS (js8gen options, '|' separated, makes the input),
#   RAW (an existing raw file), CHUNK (bytes per read for MODE=feed), CONTAIN (text that stderr must contain, MODE=fail).
# MODE:
#   compare  helper reads INPUT from a file; stdout must equal the pinned EXPECTED file byte for byte
#   twice    the same, and a second run must give identical output (determinism)
#   feed     helper reads INPUT through a pipe from js8gen --feed in CHUNK-byte pieces; same pinned output
#   f32      the same signal as 32-bit floats; every line after the hello must equal the s16 run's
#   fail     helper must exit non-zero, print nothing on stdout, and say CONTAIN on stderr
#   info     --foxsdr-helper-info must print exactly EXPECTED (the manifest) and exit 0
# Set JS8_UPDATE=1 in the environment to rewrite the pinned files after an intended change, then review the git diff.

file(MAKE_DIRECTORY "${WORK}")
string(REPLACE "|" ";" ARGLIST "${ARGS}")
set(OUT "${WORK}/${NAME}.out")
set(ERR "${WORK}/${NAME}.err")
set(IN "${RAW}")

if(DEFINED WAV)
  set(IN "${WORK}/${NAME}.raw")
  execute_process(COMMAND "${GEN}" --convert "${WAV}" "${IN}" RESULT_VARIABLE rc ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "js8gen --convert failed (${rc}): ${e}")
  endif()
elseif(DEFINED GENARGS)
  string(REPLACE "|" ";" GENLIST "${GENARGS}")
  set(IN "${WORK}/${NAME}.raw")
  execute_process(COMMAND "${GEN}" --out "${IN}" ${GENLIST} RESULT_VARIABLE rc OUTPUT_VARIABLE truth ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "js8gen failed (${rc}): ${e}")
  endif()
elseif(DEFINED GARBAGE)
  set(IN "${WORK}/${NAME}.raw")
  execute_process(COMMAND "${GEN}" --garbage "${GARBAGE}" 12345 "${IN}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "js8gen --garbage failed")
  endif()
endif()

function(finish_compare out expected)
  if(DEFINED ENV{JS8_UPDATE})
    configure_file("${out}" "${expected}" COPYONLY)
    message(STATUS "updated ${expected}")
    return()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${out}" "${expected}" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    file(READ "${out}" got)
    file(READ "${expected}" want)
    string(LENGTH "${got}" gl)
    string(LENGTH "${want}" wl)
    message(FATAL_ERROR "output differs from ${expected} (${gl} vs ${wl} bytes)\n--- got ---\n${got}\n--- expected ---\n${want}")
  endif()
endfunction()

function(run_helper in_file out_file err_file)
  if(in_file)
    execute_process(COMMAND "${HELPER}" ${ARGLIST} ${ARGN} INPUT_FILE "${in_file}" OUTPUT_FILE "${out_file}"
                    ERROR_FILE "${err_file}" RESULT_VARIABLE rc)
  else()
    execute_process(COMMAND "${HELPER}" ${ARGLIST} ${ARGN} OUTPUT_FILE "${out_file}" ERROR_FILE "${err_file}"
                    RESULT_VARIABLE rc)
  endif()
  set(RC ${rc} PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "compare" OR MODE STREQUAL "twice")
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    file(READ "${ERR}" e)
    message(FATAL_ERROR "helper exited with ${RC}\n${e}")
  endif()
  if(MODE STREQUAL "twice")
    run_helper("${IN}" "${OUT}.2" "${ERR}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}" "${OUT}.2" RESULT_VARIABLE same)
    if(NOT same EQUAL 0)
      message(FATAL_ERROR "two runs on the same input gave different output (${OUT} vs ${OUT}.2)")
    endif()
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "feed")
  if(NOT DEFINED CHUNK)
    set(CHUNK 4097)
  endif()
  execute_process(COMMAND "${GEN}" --feed "${IN}" ${CHUNK}
                  COMMAND "${HELPER}" ${ARGLIST}
                  OUTPUT_FILE "${OUT}" ERROR_FILE "${ERR}" RESULTS_VARIABLE rcs)
  list(GET rcs 1 rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "helper exited with ${rc} (feed: ${rcs})")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "f32")
  execute_process(COMMAND "${GEN}" --s16tof32 "${IN}" "${WORK}/${NAME}.f32" RESULT_VARIABLE grc)
  if(NOT grc EQUAL 0)
    message(FATAL_ERROR "js8gen --s16tof32 failed")
  endif()
  run_helper("${IN}" "${OUT}" "${ERR}")
  # the helper takes the last --format it is given, so appending f32 overrides the s16 in ARGS
  string(REPLACE "|" ";" ARGLIST "${ARGS}|--format|f32")
  run_helper("${WORK}/${NAME}.f32" "${OUT}.f32" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on the float input")
  endif()
  file(STRINGS "${OUT}" a)
  file(STRINGS "${OUT}.f32" b)
  list(LENGTH a la)
  list(LENGTH b lb)
  if(NOT la EQUAL lb OR la LESS 3)
    message(FATAL_ERROR "s16 run printed ${la} lines, f32 run ${lb} (need at least a hello, a frame and the stats)")
  endif()
  list(REMOVE_AT a 0)
  list(REMOVE_AT b 0)
  if(NOT "${a}" STREQUAL "${b}")
    message(FATAL_ERROR "float input gave different frames than 16-bit input\n--- s16 ---\n${a}\n--- f32 ---\n${b}")
  endif()

elseif(MODE STREQUAL "fail")
  run_helper("${IN}" "${OUT}" "${ERR}")
  if(RC EQUAL 0)
    message(FATAL_ERROR "helper accepted bad arguments (exit 0)")
  endif()
  file(READ "${OUT}" o)
  if(NOT "${o}" STREQUAL "")
    message(FATAL_ERROR "helper printed on stdout despite the error: ${o}")
  endif()
  file(READ "${ERR}" e)
  if(NOT "${e}" MATCHES "${CONTAIN}")
    message(FATAL_ERROR "stderr does not mention '${CONTAIN}': ${e}")
  endif()

elseif(MODE STREQUAL "info")
  execute_process(COMMAND "${HELPER}" --foxsdr-helper-info OUTPUT_FILE "${OUT}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--foxsdr-helper-info exited with ${rc}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}" "${EXPECTED}" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    message(FATAL_ERROR "manifest printed by the helper differs from ${EXPECTED}")
  endif()

else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
