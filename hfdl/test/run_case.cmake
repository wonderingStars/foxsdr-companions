# Test runner for the hfdl helper. Usage: cmake -DMODE=... -DHELPER=... [-DINPUT=...] [-DARGS="a;b"] -P run_case.cmake
# MODE: compare | twice | empty | garbage | badformat | info | absent | count | real
# HFDL_UPDATE=1 in the environment rewrites the expected file of a "compare" case instead of comparing.
cmake_minimum_required(VERSION 3.15)

if(NOT HELPER)
  message(FATAL_ERROR "HELPER not set")
endif()
set(out "${WORKDIR}/${CASE}.out")
set(err "${WORKDIR}/${CASE}.err")
file(MAKE_DIRECTORY "${WORKDIR}")

function(run_helper outfile errfile input extra_args result_var)
  if(input)
    execute_process(COMMAND "${HELPER}" ${ARGS} ${extra_args} INPUT_FILE "${input}" OUTPUT_FILE "${outfile}" ERROR_FILE "${errfile}" RESULT_VARIABLE rc)
  else()
    execute_process(COMMAND "${HELPER}" ${ARGS} ${extra_args} OUTPUT_FILE "${outfile}" ERROR_FILE "${errfile}" RESULT_VARIABLE rc)
  endif()
  set(${result_var} "${rc}" PARENT_SCOPE)
endfunction()

function(count_lines file var)
  file(STRINGS "${file}" lines)
  list(LENGTH lines n)
  set(${var} ${n} PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "compare")
  run_helper("${out}" "${err}" "${INPUT}" "" rc)
  if(NOT rc EQUAL 0)
    file(READ "${err}" e)
    message(FATAL_ERROR "helper exited with ${rc}: ${e}")
  endif()
  if("$ENV{HFDL_UPDATE}" STREQUAL "1")
    file(COPY_FILE "${out}" "${EXPECT}")
    message(STATUS "updated ${EXPECT}")
    return()
  endif()
  file(READ "${out}" got)
  file(READ "${EXPECT}" want)
  if(NOT got STREQUAL want)
    message(FATAL_ERROR "output differs from ${EXPECT} (actual output kept in ${out})")
  endif()
  count_lines("${out}" n)
  message(STATUS "${n} lines identical to ${EXPECT}")

elseif(MODE STREQUAL "twice")
  # same input, three runs: plain, again, and with a different read size. All three must be byte-identical.
  run_helper("${out}" "${err}" "${INPUT}" "" rc1)
  run_helper("${out}.2" "${err}" "${INPUT}" "" rc2)
  run_helper("${out}.3" "${err}" "${INPUT}" "--chunk;1000" rc3)
  if(NOT (rc1 EQUAL 0 AND rc2 EQUAL 0 AND rc3 EQUAL 0))
    message(FATAL_ERROR "a run failed: ${rc1} ${rc2} ${rc3}")
  endif()
  file(SHA256 "${out}" h1)
  file(SHA256 "${out}.2" h2)
  file(SHA256 "${out}.3" h3)
  if(NOT (h1 STREQUAL h2 AND h1 STREQUAL h3))
    message(FATAL_ERROR "output is not reproducible / depends on the read size: ${h1} ${h2} ${h3}")
  endif()
  count_lines("${out}" n)
  if(n LESS 2)
    message(FATAL_ERROR "no decoded events at all (${n} lines)")
  endif()
  message(STATUS "3 runs identical (${n} lines, sha256 ${h1})")

elseif(MODE STREQUAL "empty")
  run_helper("${out}" "${err}" "${INPUT}" "" rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "empty input: exit ${rc}")
  endif()
  count_lines("${out}" n)
  file(READ "${out}" got)
  if(NOT n EQUAL 1 OR NOT got MATCHES "^{\"helper\":\"hfdl\",\"version\":\"[0-9.]+\",\"protocol\":1,")
    message(FATAL_ERROR "this input must give exactly the hello line, got: ${got}")
  endif()
  message(STATUS "hello line only, exit 0")

elseif(MODE STREQUAL "garbage")
  run_helper("${out}" "${err}" "${INPUT}" "" rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "garbage input: exit ${rc}")
  endif()
  count_lines("${out}" n)
  if(n GREATER 3)
    message(FATAL_ERROR "garbage input produced ${n} output lines")
  endif()
  message(STATUS "garbage input: ${n} line(s), exit 0")

elseif(MODE STREQUAL "badformat")
  run_helper("${out}" "${err}" "${INPUT}" "" rc)
  file(READ "${out}" got)
  file(READ "${err}" msg)
  if(rc EQUAL 0 OR NOT got STREQUAL "" OR msg STREQUAL "")
    message(FATAL_ERROR "bad arguments must exit non-zero with a stderr message and an empty stdout (rc=${rc} stdout='${got}' stderr='${msg}')")
  endif()
  message(STATUS "rejected with exit ${rc}: ${msg}")

elseif(MODE STREQUAL "info")
  execute_process(COMMAND "${HELPER}" --foxsdr-helper-info OUTPUT_VARIABLE got RESULT_VARIABLE rc)
  file(READ "${EXPECT}" want)
  if(NOT rc EQUAL 0 OR NOT got STREQUAL want)
    message(FATAL_ERROR "--foxsdr-helper-info (exit ${rc}) differs from ${EXPECT}")
  endif()
  message(STATUS "manifest identical to ${EXPECT}")

elseif(MODE STREQUAL "absent")
  # decode and make sure none of the FORBIDDEN strings appears anywhere in the output and all REQUIRED ones do
  run_helper("${out}" "${err}" "${INPUT}" "" rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "exit ${rc}")
  endif()
  file(READ "${out}" got)
  foreach(s ${FORBIDDEN})
    string(FIND "${got}" "${s}" pos)
    if(NOT pos EQUAL -1)
      message(FATAL_ERROR "'${s}' found in the output of --hide-ids")
    endif()
  endforeach()
  foreach(s ${REQUIRED})
    string(FIND "${got}" "${s}" pos)
    if(pos EQUAL -1)
      message(FATAL_ERROR "'${s}' missing from the output")
    endif()
  endforeach()
  message(STATUS "none of [${FORBIDDEN}] in the output, all of [${REQUIRED}] present")

elseif(MODE STREQUAL "count")
  # decode a generated single-burst file and expect exactly EXPECT_PDUS decoded events, none with errors
  run_helper("${out}" "${err}" "${INPUT}" "" rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "exit ${rc}")
  endif()
  file(STRINGS "${out}" lines)
  set(n_pdu 0)
  foreach(l ${lines})
    if(l MATCHES "^{\"t\":[0-9.]+,\"type\":\"hfdl\"" AND NOT l MATCHES "\"err\":true")
      math(EXPR n_pdu "${n_pdu}+1")
    endif()
  endforeach()
  if(NOT n_pdu EQUAL EXPECT_PDUS)
    message(FATAL_ERROR "expected ${EXPECT_PDUS} decoded PDUs, got ${n_pdu}")
  endif()
  message(STATUS "${n_pdu} PDU(s) decoded")

elseif(MODE STREQUAL "real")
  # counts only: a real off-air recording (kept outside the repository)
  if(NOT EXISTS "${WAV}")
    message(STATUS "SKIPPED: ${WAV} not present")
    return()
  endif()
  execute_process(COMMAND "${WAVDATA}" "${WAV}" COMMAND "${HELPER}" ${ARGS} OUTPUT_FILE "${out}" ERROR_FILE "${err}" RESULTS_VARIABLE rcs)
  file(STRINGS "${out}" lines)
  set(n_pdu 0)
  set(n_bad 0)
  foreach(l ${lines})
    if(l MATCHES "^{\"t\":[0-9.]+,\"type\":\"hfdl\"")
      math(EXPR n_pdu "${n_pdu}+1")
      if(l MATCHES "\"err\":true")
        math(EXPR n_bad "${n_bad}+1")
      endif()
    endif()
  endforeach()
  message(STATUS "real recording: ${n_pdu} decoded PDUs, ${n_bad} with errors (expected ${EXPECT_PDUS} / 0)")
  if(NOT n_pdu EQUAL EXPECT_PDUS OR NOT n_bad EQUAL 0)
    message(FATAL_ERROR "real recording: expected ${EXPECT_PDUS} PDUs without errors, got ${n_pdu} / ${n_bad}")
  endif()

else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
