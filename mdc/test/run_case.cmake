# Test driver for the mdc helper: one script, several modes (-DMODE=...), run by CTest as
#   cmake -DMODE=... -DHELPER=... -DGEN=... [-DARGS=a|b|c] [-DEXPECTED=...] -P run_case.cmake
# GEN and ARGS are lists separated by '|' (CTest cannot pass lists with ';' reliably). GEN is the argument list of mdc-gen
# (options first, then items); the driver adds --raw <work file>.
# Set the environment variable MDC_UPDATE=1 to rewrite EXPECTED from the current output instead of comparing
# (review the diff before committing it).
#
# MODE
#   gen       mdc-gen makes WORK/NAME.raw from GEN, helper reads it; stdout must equal EXPECTED byte for byte, exit code 0
#   twice     as gen, and a second run must give identical output (determinism)
#   pipe      as gen, but the signal is fed to the helper through a pipe in small writes (CHUNK bytes), same EXPECTED
#   empty     empty stdin: stdout must equal EXPECTED (hello and stats), exit code 0
#   fail      helper run with ARGS: exit code must be 2, stdout empty, stderr must match STDERR_REGEX
#   garbage   mdc-gen makes pure noise from GEN: exit code 0, at most MAX_LINES lines out
#   oddbyte   as gen with --odd-byte: stdout equals EXPECTED, stderr mentions the stray byte
#   info      --foxsdr-helper-info output must equal the manifest file EXPECTED
#   wav       mdc-gen --wav and --raw of the same signal: WAV size must be raw size + 44, header must start RIFF
if(NOT DEFINED NAME)
  set(NAME case)
endif()
file(MAKE_DIRECTORY "${WORK}")
string(REPLACE "|" ";" ARGLIST "${ARGS}")
string(REPLACE "|" ";" GENLIST "${GEN}")
set(RAW "${WORK}/${NAME}.raw")
set(OUT "${WORK}/${NAME}.out")
set(ERR "${WORK}/${NAME}.err")

function(finish_compare out expected)
  if(DEFINED ENV{MDC_UPDATE})
    configure_file("${out}" "${expected}" COPYONLY)
    message(STATUS "updated ${expected}")
    return()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${out}" "${expected}" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    file(READ "${out}" got)
    file(READ "${expected}" want)
    message(FATAL_ERROR "output differs from ${expected}\n--- got ---\n${got}\n--- expected ---\n${want}")
  endif()
endfunction()

function(make_signal)
  file(REMOVE "${RAW}")
  execute_process(COMMAND "${MDCGEN}" --raw "${RAW}" ${ARGN} ${GENLIST} RESULT_VARIABLE grc ERROR_VARIABLE generr)
  if(NOT grc EQUAL 0 OR NOT EXISTS "${RAW}")
    message(FATAL_ERROR "mdc-gen failed (${grc}): ${generr}")
  endif()
endfunction()

function(run_helper in_file out_file err_file)
  execute_process(COMMAND "${HELPER}" ${ARGLIST}
                  INPUT_FILE "${in_file}" OUTPUT_FILE "${out_file}" ERROR_FILE "${err_file}" RESULT_VARIABLE rc)
  set(RC ${rc} PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "gen" OR MODE STREQUAL "twice")
  make_signal()
  run_helper("${RAW}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    file(READ "${ERR}" e)
    message(FATAL_ERROR "helper exited with ${RC}\n${e}")
  endif()
  if(MODE STREQUAL "twice")
    run_helper("${RAW}" "${OUT}.2" "${ERR}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}" "${OUT}.2" RESULT_VARIABLE same)
    if(NOT same EQUAL 0)
      message(FATAL_ERROR "two runs on the same input gave different output")
    endif()
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "pipe")
  make_signal()
  if(NOT DEFINED CHUNK)
    set(CHUNK 777)
  endif()
  execute_process(COMMAND "${MDCGEN}" feed "${RAW}" ${CHUNK}
                  COMMAND "${HELPER}" ${ARGLIST}
                  OUTPUT_FILE "${OUT}" ERROR_FILE "${ERR}" RESULTS_VARIABLE rcs)
  list(GET rcs 1 rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "helper exited with ${rc} (${rcs})")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "empty")
  file(WRITE "${RAW}" "")
  run_helper("${RAW}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on empty input")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "fail")
  file(WRITE "${RAW}" "")
  run_helper("${RAW}" "${OUT}" "${ERR}")
  file(READ "${OUT}" o)
  file(READ "${ERR}" e)
  if(NOT RC EQUAL 2)
    message(FATAL_ERROR "expected exit code 2, got ${RC}; stderr: ${e}")
  endif()
  if(NOT "${o}" STREQUAL "")
    message(FATAL_ERROR "expected no stdout, got: ${o}")
  endif()
  if(NOT e MATCHES "${STDERR_REGEX}")
    message(FATAL_ERROR "stderr does not match ${STDERR_REGEX}: ${e}")
  endif()

elseif(MODE STREQUAL "garbage")
  make_signal()
  run_helper("${RAW}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC} on noise")
  endif()
  file(STRINGS "${OUT}" lines)
  list(LENGTH lines n)
  if(n GREATER MAX_LINES)
    message(FATAL_ERROR "noise input produced ${n} lines (limit ${MAX_LINES})")
  endif()
  message(STATUS "noise input produced ${n} lines")

elseif(MODE STREQUAL "oddbyte")
  make_signal(--odd-byte)
  run_helper("${RAW}" "${OUT}" "${ERR}")
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "helper exited with ${RC}")
  endif()
  file(READ "${ERR}" e)
  if(NOT e MATCHES "stray byte")
    message(FATAL_ERROR "stderr does not mention the stray byte: ${e}")
  endif()
  finish_compare("${OUT}" "${EXPECTED}")

elseif(MODE STREQUAL "info")
  execute_process(COMMAND "${HELPER}" --foxsdr-helper-info OUTPUT_FILE "${OUT}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--foxsdr-helper-info exited with ${rc}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}" "${EXPECTED}" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    # the manifest in the work tree may carry CRLF line endings; compare ignoring them
    file(READ "${OUT}" got)
    file(READ "${EXPECTED}" want)
    string(REPLACE "\r\n" "\n" want "${want}")
    if(NOT "${got}" STREQUAL "${want}")
      message(FATAL_ERROR "--foxsdr-helper-info differs from ${EXPECTED}")
    endif()
  endif()

elseif(MODE STREQUAL "wav")
  file(REMOVE "${RAW}" "${WORK}/${NAME}.wav")
  execute_process(COMMAND "${MDCGEN}" --raw "${RAW}" --wav "${WORK}/${NAME}.wav" ${GENLIST} RESULT_VARIABLE grc)
  if(NOT grc EQUAL 0)
    message(FATAL_ERROR "mdc-gen failed (${grc})")
  endif()
  file(SIZE "${RAW}" rs)
  file(SIZE "${WORK}/${NAME}.wav" ws)
  math(EXPR want "${rs} + 44")
  if(NOT ws EQUAL want)
    message(FATAL_ERROR "wav size ${ws}, expected ${want}")
  endif()
  file(READ "${WORK}/${NAME}.wav" head LIMIT 4)
  if(NOT head STREQUAL "RIFF")
    message(FATAL_ERROR "wav does not start with RIFF")
  endif()

else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
