+            LOG(ERR, "address list: unsupported or truncated address");
+            *ptr_addrs = addrs;
+            return addrs ? 0 : -1;
+        }
         const int l = sizeof(address_list_t) + n * sizeof(address_t);
         address_list_t *p = realloc(addrs, l);
         if (!p) {
@@ -105,10 +143,11 @@ int address_list_decode(address_list_t **ptr_addrs, const uint8_t *data)
         }
         addrs = p;
         addrs->nadrs = n;
-    } while (address_decode(&addrs->called_adr[addrs->nadrs-1], &data));
+        more = address_decode(&addrs->called_adr[addrs->nadrs-1], &data);
+        len -= sz;
+    } while (more);
 
